ENV=LOCAL

# PostgreSQL runs on the host and is shared by the application and Airflow metadata.
DB_USER=former
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=former
DATABASE_URL=postgresql+psycopg2://former:change-me@host.docker.internal:5432/former

LOCAL_DB_USER=former
LOCAL_DB_PASSWORD=change-me
LOCAL_DB_HOST=host.docker.internal
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=former
LOCAL_DATABASE_URL=postgresql+psycopg2://former:change-me@host.docker.internal:5432/former
LOCAL_AIRFLOW_DB_URI=postgresql+psycopg2://former:change-me@host.docker.internal:5432/former

LOCAL_AIRFLOW_HOST=http://localhost:9090
LOCAL_AIRFLOW_BASE_URL=http://localhost:9090/api/v2
LOCAL_AIRFLOW_USERNAME=admin
LOCAL_AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=form_filler_plan
