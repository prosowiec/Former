## Local development only. Copy this file to .env.
APP_ENV=local

# PostgreSQL runs on the host and is shared by the application and Airflow metadata.
DB_USER=former
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=former
DATABASE_URL=postgresql+psycopg2://former:change-me@host.docker.internal:5432/former
AIRFLOW_DB_URI=postgresql+psycopg2://former:change-me@host.docker.internal:5432/former

FRONTEND_URL=http://localhost
AIRFLOW_HOST=http://localhost:9090
AIRFLOW_BASE_URL=http://localhost:9090/api/v2
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=form_filler_plan
SCHEDULER_JITTER_RATIO=0.20
SCHEDULER_MAX_JITTER_MINUTES=2.0

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
OPENAI_API_KEY=
GEMINI_API_KEY=
# Generate independent values; never copy these into YAML manifests.
AIRFLOW_CORE_JWT_SECRET_KEY=
AIRFLOW_API_AUTH_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
