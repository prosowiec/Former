## Production template. Configure these as deployment secrets/settings;
## do not copy production credentials into the local .env file.
APP_ENV=production

DATABASE_URL=postgresql+psycopg2://user:password@database-host:5432/former
AIRFLOW_DB_URI=postgresql+psycopg2://user:password@database-host:5432/former

FRONTEND_URL=https://former.com.pl
AIRFLOW_HOST=http://localhost:8080
AIRFLOW_BASE_URL=http://localhost:8080/api/v2
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_DAG_ID=form_filler_plan
SCHEDULER_JITTER_RATIO=0.20
SCHEDULER_MAX_JITTER_MINUTES=2.0

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
OPENAI_API_KEY=
GEMINI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://former.com.pl/auth/callback

STRIPE_PUBLISHABLE_KEY=
